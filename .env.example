# Local development only; replace passwords with unique letters and digits in .env.
MYSQL_DATABASE=limited_sale
MYSQL_USER=limited_sale
MYSQL_PASSWORD=replace_me
MYSQL_ROOT_PASSWORD=replace_me_too
MYSQL_PORT=3306
MOCK_PG_DATABASE=mock_pg
MOCK_PG_USER=mock_pg
MOCK_PG_PASSWORD=replace_me_pg
MOCK_PG_PORT=8081
REDIS_PORT=6379
# Use the same non-empty local-only value in both application environments.
MOCK_PG_API_KEY=replace_with_unique_local_key
MOCK_PG_BASE_URL=http://localhost:8081
